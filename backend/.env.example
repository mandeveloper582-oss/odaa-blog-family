# Example backend environment variables
# Copy this to .env and fill values for local development. DO NOT commit secrets.

# MongoDB Atlas connection string (SRV). Replace <USER>, <PASSWORD> and <DBNAME>
MONGO_URI="mongodb+srv://<USER>:<PASSWORD>@cluster0.mongodb.net/<DBNAME>?retryWrites=true&w=majority"

# JWT secret used to sign tokens
JWT_SECRET=your_jwt_secret_here

# Admin account email and bcrypt password hash (store hash, not plaintext)
ADMIN_EMAIL=galataaomer@gmail.com
ADMIN_PASSWORD_HASH=$2b$12$UkheV2p.xmYqQU9/As4Iw.5ubE.Tyj6ZA8kpxoLe4mKspfG24JpBS

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL(s) allowed by CORS (comma-separated)
FRONTEND_URL=https://your-vercel-app.vercel.app

# Used by client to call API (no trailing /api)
VITE_API_URL=https://your-render-service.onrender.com

# Port for local dev server
PORT=5000
